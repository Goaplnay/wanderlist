<% layout('/layouts/boilerplate') %>

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">🔔 My Bookings</h2>
      <p class="text-muted mb-0">Tumhari saari bookings yahan hain</p>
    </div>
    <a href="/listings" class="btn fw-bold text-white px-4"
      style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; border: none;">
      🏠 Browse Listings
    </a>
  </div>

  <% if(bookings.length === 0) { %>
    <div class="text-center py-5">
      <div style="font-size: 4rem;">📭</div>
      <h5 class="text-muted mt-2">Abhi koi booking nahi hai!</h5>
      <a href="/listings" class="btn btn-dark mt-3 rounded-pill px-4">
        🏠 Listings Browse Karo
      </a>
    </div>
  <% } %>

  <div class="row g-4">
    <% for(let booking of bookings) { %>
      <% if(booking.listing) { %>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">

          <div class="d-flex">
            <img
              src="<%= booking.listing.image.url %>"
              style="width: 130px; height: 130px; object-fit: cover;"
              alt="listing"
            >
            <div class="p-3 flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="fw-bold mb-1"><%= booking.listing.title %></h6>
                <span class="badge rounded-pill
                  <%= booking.status === 'confirmed' ? 'bg-success' :
                      booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning' %>">
                  <%= booking.status %>
                </span>
              </div>

              <p class="text-muted mb-1" style="font-size: 0.82rem;">
                📍 <%= booking.listing.location %>, <%= booking.listing.country %>
              </p>

              <p class="mb-1" style="font-size: 0.85rem;">
                📅 <%= new Date(booking.checkIn).toLocaleDateString("en-IN") %>
                → <%= new Date(booking.checkOut).toLocaleDateString("en-IN") %>
              </p>

              <p class="mb-1" style="font-size: 0.85rem;">
                👥 <%= booking.guests %> Guest<%= booking.guests > 1 ? 's' : '' %>
              </p>

              <p class="fw-bold mb-2" style="color: #764ba2; font-size: 0.9rem;">
                💰 Total: ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>
              </p>

              <% if(booking.status !== 'cancelled') { %>
              <form method="POST" action="/bookings/<%= booking._id %>/cancel">
                <button class="btn btn-sm btn-outline-danger rounded-pill">
                  ❌ Cancel
                </button>
              </form>
              <% } %>
            </div>
          </div>

        </div>
      </div>
      <% } %>
    <% } %>
  </div>

</div>