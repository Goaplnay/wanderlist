<% layout('layouts/boilerplate') %>

<div class="container mt-4">
  <div class="row g-4">

    <!-- LEFT SIDE - Image + Details -->
    <div class="col-md-7">

      <!-- Image -->
      <!-- Image Gallery -->
<% if(listing.images && listing.images.length > 1) { %>
  <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel"
    style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12);">
    <div class="carousel-indicators">
      <% for(let i = 0; i < listing.images.length; i++) { %>
        <button type="button" data-bs-target="#listingCarousel"
          data-bs-slide-to="<%= i %>"
          class="<%= i === 0 ? 'active' : '' %>">
        </button>
      <% } %>
    </div>
    <div class="carousel-inner">
      <% for(let i = 0; i < listing.images.length; i++) { %>
        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
          <img src="<%= listing.images[i].url %>"
            class="d-block w-100"
            style="height: 400px; object-fit: cover;"
            alt="listing image">
        </div>
      <% } %>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>
<% } else { %>
  <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12);">
    <img
      src="<%= listing.image?.url || '/images/default.jpg' %>"
      class="w-100"
      style="height: 400px; object-fit: cover;"
      alt="listing image"
    >
  </div>
<% } %>

      <!-- Title + Owner -->
      <div class="mt-3 d-flex justify-content-between align-items-center">
        <div>
          <h2 class="fw-bold mb-1"><%= listing.title %></h2>
          <p class="text-muted mb-0">
            📍 <%= listing.location %>, <%= listing.country %>
          </p>
        </div>
        <% if(listing.category) { %>
          <span class="badge px-3 py-2"
            style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; font-size: 0.85rem;">
            <%= listing.category %>
          </span>
        <% } %>
      </div>

      <hr>

      <!-- Details Card -->
      <div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 12px;">
        <div class="row g-3">
          <div class="col-6">
            <p class="text-muted mb-0" style="font-size: 0.8rem;">HOSTED BY</p>
            <p class="fw-bold mb-0">👤 <%= listing.owner?.username || "Unknown" %></p>
          </div>
          <div class="col-6">
            <p class="text-muted mb-0" style="font-size: 0.8rem;">PRICE</p>
            <p class="fw-bold mb-0" style="color: #764ba2;">
              ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/night
            </p>
          </div>
          <div class="col-12">
            <p class="text-muted mb-0" style="font-size: 0.8rem;">DESCRIPTION</p>
            <p class="mb-0"><%= listing.description %></p>
          </div>
        </div>
      </div>

      <!-- BOOKING FORM -->
<% if(currentUser && listing.owner && !currentUser._id.equals(listing.owner._id)) { %>
<div class="card border-0 shadow-sm p-4 mb-3" style="border-radius: 16px;">
  <h5 class="fw-bold mb-3">🔔 Book This Listing</h5>

  <form action="/bookings/<%= listing._id %>" method="POST">

    <div class="row g-2 mb-3">
      <div class="col-6">
        <label class="form-label fw-bold" style="font-size: 0.85rem;">CHECK-IN</label>
        <input type="date" name="checkIn" class="form-control" required
          min="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div class="col-6">
        <label class="form-label fw-bold" style="font-size: 0.85rem;">CHECK-OUT</label>
        <input type="date" name="checkOut" class="form-control" required
          min="<%= new Date().toISOString().split('T')[0] %>">
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label fw-bold" style="font-size: 0.85rem;">GUESTS</label>
      <input type="number" name="guests" class="form-control" min="1" max="10" value="1" required>
    </div>

    <div id="pricePreview" class="alert alert-light mb-3" style="display:none; border-radius: 10px;">
      <p class="mb-0 fw-bold" id="priceText"></p>
    </div>

    <button type="submit" class="btn w-100 fw-bold text-white py-2"
      style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; border: none;">
      🔔 Book Now
    </button>

  </form>
</div>
<% } %>

<% if(!currentUser) { %>
<div class="card border-0 shadow-sm p-4 mb-3 text-center" style="border-radius: 16px;">
  <p class="mb-2">Booking karne ke liye login karo!</p>
  <a href="/login" class="btn btn-dark rounded-pill px-4">🔐 Login</a>
</div>
<% } %>

      <!-- Edit/Delete Buttons -->
      <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
      <div class="d-flex gap-2 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
          ✏️ Edit Listing
        </a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
          <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
            🗑️ Delete
          </button>
        </form>
      </div>
      <% } %>

    </div>

    <!-- RIGHT SIDE - Reviews -->
    <div class="col-md-5">

      <!-- Leave Review -->
      <% if(currentUser) { %>
      <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold mb-3">⭐ Leave a Review</h5>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

          <div class="mb-3">
            <label class="form-label fw-bold">Rating: <span id="ratingVal">3</span>/5</label>
            <input
              type="range"
              min="1"
              max="5"
              value="3"
              id="rating"
              name="review[rating]"
              class="form-range"
              oninput="document.getElementById('ratingVal').textContent = this.value"
            >
            <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
              <span>1 ⭐</span>
              <span>5 ⭐</span>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Comment</label>
            <textarea
              name="review[comment]"
              rows="4"
              class="form-control"
              placeholder="Apna experience share karo..."
              required
              style="border-radius: 10px;"
            ></textarea>
            <div class="invalid-feedback">Comment required hai!</div>
          </div>

          <button class="btn btn-dark w-100 rounded-pill">Submit Review</button>
        </form>
      </div>
      <% } %>

      <% if(!currentUser) { %>
      <div class="card border-0 shadow-sm p-4 mb-4 text-center" style="border-radius: 16px;">
        <p class="mb-2">Review dene ke liye login karo!</p>
        <a href="/login" class="btn btn-dark rounded-pill px-4">🔐 Login</a>
      </div>
      <% } %>

      <!-- AI Review Summarizer -->
      <% if(listing.reviews.length > 0) { %>
      <div class="mb-3">
        <button id="summarizeBtn" class="btn btn-sm fw-bold text-white w-100"
          style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; border: none; padding: 10px;">
          🤖 AI Se Reviews Summarize Karo
        </button>
      </div>

      <div id="summaryResult" class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 12px; display:none;">
        <h6 class="fw-bold mb-2">🤖 AI Summary:</h6>
        <div id="summaryText" style="white-space: pre-wrap; line-height: 1.6;"></div>
      </div>
      <% } %>

      <!-- All Reviews -->
      <h5 class="fw-bold mb-3">
        💬 All Reviews
        <span class="badge bg-secondary ms-1"><%= listing.reviews.length %></span>
      </h5>

      <% if(listing.reviews.length === 0) { %>
        <div class="text-center text-muted py-4">
          <div style="font-size: 2.5rem;">📭</div>
          <p>Abhi koi review nahi hai. Pehle review do!</p>
        </div>
      <% } %>

      <% for(let review of listing.reviews) { %>
      <div class="card border-0 shadow-sm mb-3 p-3" style="border-radius: 12px;">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h6 class="fw-bold mb-1">
              👤 <%= review.author?.username || "Unknown" %>
            </h6>
            <div class="mb-1">
              <% for(let i = 1; i <= 5; i++) { %>
                <% if(i <= review.rating) { %>
                  <span style="color: #f5a623;">★</span>
                <% } else { %>
                  <span style="color: #ddd;">★</span>
                <% } %>
              <% } %>
              <span class="text-muted ms-1" style="font-size: 0.8rem;"><%= review.rating %>/5</span>
            </div>
            <p class="mb-0"><%= review.comment %></p>
          </div>

          <% if(currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
          <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-outline-danger rounded-pill">🗑️</button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>

    </div>

  </div>
</div>

<!-- AI Summarizer Script -->
<script>
  const summarizeBtn = document.getElementById("summarizeBtn");

  if(summarizeBtn) {
    summarizeBtn.addEventListener("click", async () => {
      summarizeBtn.disabled = true;
      summarizeBtn.textContent = "🤖 Soch raha hun...";

      const reviews = [
        <% for(let review of listing.reviews) { %>
          { rating: <%= review.rating %>, comment: "<%= review.comment.replace(/"/g, '\\"').replace(/\n/g, ' ') %>" },
        <% } %>
      ];

      try {
        const res = await fetch("/chatbot/summarize-reviews", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reviews }),
        });

        const data = await res.json();

        const summaryResult = document.getElementById("summaryResult");
        const summaryText = document.getElementById("summaryText");

        summaryResult.style.display = "block";
        summaryText.innerHTML = data.summary
          .replace(/\*\*(.*?)\*\*/g, "<b>$1</b>")
          .replace(/\n/g, "<br>");

      } catch (err) {
        alert("Error aa gaya! Dobara try karo.");
      }

      summarizeBtn.disabled = false;
      summarizeBtn.textContent = "🤖 AI Se Reviews Summarize Karo";
    });
  }
    // Price Preview
  const checkIn = document.querySelector("input[name='checkIn']");
  const checkOut = document.querySelector("input[name='checkOut']");
  const pricePreview = document.getElementById("pricePreview");
  const priceText = document.getElementById("priceText");
  const pricePerNight = <%= listing.price %>;

  function updatePrice() {
    if(checkIn && checkOut && checkIn.value && checkOut.value) {
      const nights = Math.ceil((new Date(checkOut.value) - new Date(checkIn.value)) / (1000 * 60 * 60 * 24));
      if(nights > 0) {
        const total = nights * pricePerNight;
        priceText.textContent = `${nights} night${nights > 1 ? 's' : ''} × ₹${pricePerNight.toLocaleString('en-IN')} = ₹${total.toLocaleString('en-IN')}`;
        pricePreview.style.display = "block";
      }
    }
  }

  if(checkIn) checkIn.addEventListener("change", updatePrice);
  if(checkOut) checkOut.addEventListener("change", updatePrice);
</script>