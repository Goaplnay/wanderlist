<!DOCTYPE html>
<html>
<head>
  <title>Hello</title>
</head>
<body>

  <% if (success.length > 0) { %>
    <p style="color: green;"><%= success[0] %></p>
  <% } %>

  <% if (error.length > 0) { %>
    <p style="color: red;"><%= error[0] %></p>
  <% } %>

  <h1>Hello, <%= name %> 👋</h1>

</body>
</html>
