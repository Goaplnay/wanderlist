<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

  <!-- Profile Header -->
  <div class="card border-0 shadow mb-4" style="border-radius: 20px; overflow: hidden;">
    <div class="py-5 text-center text-white"
      style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center mb-3"
        style="width: 80px; height: 80px; font-size: 2.5rem;">
        👤
      </div>
      <h2 class="fw-bold mb-1"><%= currentUser.username %></h2>
      <p class="text-white-50 mb-0"><%= currentUser.email %></p>
      <span class="badge mt-2 px-3 py-2"
        style="background: rgba(255,255,255,0.2); border-radius: 50px;">
        🏠 <%= userListings.length %> Listing<%= userListings.length !== 1 ? 's' : '' %>
      </span>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm text-center p-4" style="border-radius: 16px;">
        <div style="font-size: 2rem;">🏠</div>
        <h3 class="fw-bold mb-0" style="color: #764ba2;"><%= userListings.length %></h3>
        <p class="text-muted mb-0">Total Listings</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm text-center p-4" style="border-radius: 16px;">
        <div style="font-size: 2rem;">⭐</div>
        <h3 class="fw-bold mb-0" style="color: #764ba2;">
          <%= userListings.reduce((acc, l) => acc + l.reviews.length, 0) %>
        </h3>
        <p class="text-muted mb-0">Total Reviews</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm text-center p-4" style="border-radius: 16px;">
        <div style="font-size: 2rem;">💰</div>
        <h3 class="fw-bold mb-0" style="color: #764ba2;">
          ₹ <%= userListings.length > 0 ? Math.round(userListings.reduce((acc, l) => acc + l.price, 0) / userListings.length).toLocaleString("en-IN") : 0 %>
        </h3>
        <p class="text-muted mb-0">Avg Price/night</p>
      </div>
    </div>
  </div>

  <!-- My Listings -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">🏠 My Listings</h4>
    <a href="/listings/new" class="btn btn-sm fw-bold text-white px-4"
      style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; border: none;">
      ➕ Add New
    </a>
  </div>

  <div class="row g-4">
    <% if(userListings.length === 0) { %>
      <div class="col-12 text-center py-5">
        <div style="font-size: 3rem;">🏜️</div>
        <h5 class="text-muted mt-2">Abhi koi listing nahi hai!</h5>
        <a href="/listings/new" class="btn btn-dark mt-3 rounded-pill px-4">
          ➕ Pehli Listing Banao
        </a>
      </div>
    <% } %>

    <% for(let listing of userListings) { %>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; overflow: hidden;">
          <img
            src="<%= listing.image.url %>"
            style="height: 180px; object-fit: cover;"
            alt="listing image"
          >
          <div class="card-body p-3">
            <h6 class="fw-bold mb-1"><%= listing.title %></h6>
            <p class="text-muted mb-1" style="font-size: 0.85rem;">
              📍 <%= listing.location %>, <%= listing.country %>
            </p>
            <p class="fw-bold mb-2" style="color: #764ba2;">
              ₹ <%= listing.price.toLocaleString("en-IN") %>/night
            </p>
            <div class="d-flex gap-2">
              <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill flex-grow-1">
                👁️ View
              </a>
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-dark rounded-pill flex-grow-1">
                ✏️ Edit
              </a>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

</div>