<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-5">

      <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">

        <!-- Card Header -->
        <div class="text-center py-4"
          style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
          <div style="font-size: 2.5rem;">🧭</div>
          <h3 class="text-white fw-bold mb-0">Welcome Back!</h3>
          <p class="text-white-50 mb-0">WanderList pe login karo</p>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">
          <form action="/login" method="POST" class="needs-validation" novalidate>

            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label fw-bold text-muted" style="font-size: 0.85rem;">USERNAME</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="fa-solid fa-user text-muted"></i>
                </span>
                <input
                  type="text"
                  class="form-control border-start-0 bg-light"
                  id="username"
                  name="username"
                  placeholder="Apna username daalo"
                  required
                  style="border-radius: 0 10px 10px 0;"
                >
              </div>
            </div>

            <!-- Password -->
            <div class="mb-4">
              <label for="password" class="form-label fw-bold text-muted" style="font-size: 0.85rem;">PASSWORD</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="fa-solid fa-lock text-muted"></i>
                </span>
                <input
                  type="password"
                  class="form-control border-start-0 bg-light"
                  id="password"
                  name="password"
                  placeholder="Apna password daalo"
                  required
                  style="border-radius: 0 10px 10px 0;"
                >
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn w-100 fw-bold py-2 text-white"
              style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; border: none;">
              Login 🚀
            </button>

          </form>

          <!-- Divider -->
          <div class="text-center my-3">
            <span class="text-muted" style="font-size: 0.85rem;">Account nahi hai?</span>
          </div>

          <!-- Signup Link -->
          <a href="/signup" class="btn w-100 btn-outline-secondary fw-bold py-2"
            style="border-radius: 50px;">
            ✨ Sign Up Karo
          </a>

        </div>
      </div>

    </div>
  </div>
</div>